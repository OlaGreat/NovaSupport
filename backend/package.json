{
  "name": "novasupport-backend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "NODE_ENV=test JWT_SECRET=test-secret node --import tsx --test \"src/**/*.test.ts\"",
    "test:watch": "NODE_ENV=test JWT_SECRET=test-secret node --import tsx --test --watch \"src/**/*.test.ts\"",
    "test:coverage": "NODE_ENV=test JWT_SECRET=test-secret node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "0.60.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/sdk-node": "0.57.2",
    "@prisma/client": "^6.5.0",
    "@sentry/node": "^8.55.2",
    "@stellar/stellar-sdk": "^14.6.1",
    "@supabase/supabase-js": "^2.100.1",
    "bullmq": "^5.81.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sanitize-html": "^2.17.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.5.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2"
  }
}
